# Copy this file to .env and fill it in. .env is gitignored: never commit it.
# Only the content-generation and Firework API scripts read these values.
# The website itself needs no secrets.

# fal.ai key for image, video and voice generation (https://fal.ai/dashboard/keys)
FAL_KEY=

# Hard cap for total generation spend in USD, tracked in content/ledger.json
GEN_MAX_USD=30

# Firework Public API (OAuth client credentials) for the sandbox business. Used from Week 3.
# FIREWORK_CLIENT_ID=
# FIREWORK_CLIENT_SECRET=
# FIREWORK_CHANNEL_ID=
# FIREWORK_BUSINESS_STORE_ID=
