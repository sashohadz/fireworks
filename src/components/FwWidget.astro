---
/**
 * Renders one Firework web component exactly as a customer would paste it.
 * With no channel configured, it renders a placeholder that src/scripts/firework-loader.ts
 * turns into the real element once a channel is set in Settings or the URL.
 * With defer, it always renders the placeholder; a page script turns it into the element later
 * (the layout gallery does this as each example scrolls into view).
 */
import { firework, type PlaylistSlot } from '../site.config';

type FwTag = 'fw-embed-feed' | 'fw-storyblock' | 'fw-player-deck' | 'fw-herounit' | 'fw-player';

interface Props {
  tag: FwTag;
  /** Which playlist from site.config.ts this widget uses. */
  slot?: PlaylistSlot;
  /** Set false for feeds that must not get a playlist, such as skus or hashtag feeds. */
  usePlaylist?: boolean;
  /** Name for ?widgets= when the slot doesn't identify the widget (two widgets on one slot, or no slot). */
  key?: string;
  /**
   * Space to reserve before the SDK upgrades the element (a CSS length), so the page doesn't jump when it renders.
   * Defaults to the height attribute. Carousel rows render 400px tall, circle stories 136px, a Player Deck about 520px.
   */
  reserve?: string;
  attrs?: Record<string, string | number | boolean | undefined>;
  label?: string;
  class?: string;
  style?: string;
  defer?: boolean;
}

const { tag, slot, usePlaylist = true, key, reserve, attrs = {}, label, class: className, style, defer = false } = Astro.props;

const ownAttrs: Record<string, string> = {};
for (const [name, value] of Object.entries(attrs)) {
  if (value !== undefined && value !== '') ownAttrs[name] = String(value);
}

const channel = firework.channel;
const playlist = usePlaylist && slot ? firework.playlists[slot] : '';
const liveAttrs: Record<string, string> = {
  ...(channel ? { channel } : {}),
  ...(playlist ? { playlist } : {}),
  ...ownAttrs,
};
const Tag = tag;
// Until the SDK upgrades the element it has no height, and while upgrading it briefly loses its box altogether, so
// the space is held by a wrapper, not the element. Nothing below the widget moves when the videos render.
const reserved = reserve ?? (typeof attrs.height === 'string' ? attrs.height : undefined);
---

{
  (() => {
    const widget =
      channel && !defer ? (
        <Tag
          data-fw-managed="true"
          data-fw-slot={slot}
          data-fw-key={key}
          data-fw-use-playlist={usePlaylist ? undefined : 'false'}
          class={className}
          style={style}
          {...liveAttrs}
        ></Tag>
      ) : (
        <div
          class:list={['fw-placeholder', className]}
          style={style}
          data-fw-managed="true"
          data-fw-slot={slot}
          data-fw-key={key}
          data-fw-use-playlist={usePlaylist ? undefined : 'false'}
          data-fw-tag={tag}
          data-fw-attrs={JSON.stringify(ownAttrs)}
          data-fw-defer={defer ? 'true' : undefined}
        >
          <p class="fw-placeholder-title">{label ?? tag}</p>
          {defer && channel ? (
            <p>Loads when you scroll here.</p>
          ) : (
            <p>
              The Firework <code>&lt;{tag}&gt;</code> widget renders here once a channel is set. Open{' '}
              <button type="button" class="link-btn" data-open-settings>
                Settings
              </button>{' '}
              or add <code>?channel=your_channel</code> to the URL.
            </p>
          )}
        </div>
      );
    return reserved ? (
      <div class="fw-reserve" data-fw-hero={tag === 'fw-herounit' ? 'true' : undefined} style={`--fw-reserve:${reserved}`}>
        {widget}
      </div>
    ) : (
      widget
    );
  })()
}
