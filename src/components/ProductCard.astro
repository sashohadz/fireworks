---
import {
  formatPrice,
  hasPriceRange,
  isOnSale,
  isProductAvailable,
  minPrice,
  productImages,
  productPath,
  webpSrcset,
  type Product,
} from '../lib/catalog';

interface Props {
  product: Product;
  /** For cards in the first screen: load the image at once instead of lazily, so it can be the LCP image. */
  eager?: boolean;
}
const { product, eager = false } = Astro.props;
const image = productImages(product)[0];
const sale = isOnSale(product);
const available = isProductAvailable(product);
const compare = product.units.find((u) => u.compareAtPrice)?.compareAtPrice;
const lowStock = available && product.units.some((u) => u.stock > 0 && u.stock <= 5);
---

<a class="product-card" href={productPath(product)} data-category={product.category}>
  <div class="product-card-media">
    <img
      src={image}
      srcset={webpSrcset(image)}
      sizes="(max-width: 640px) 92vw, (max-width: 1100px) 30vw, 280px"
      alt={product.name}
      width="600"
      height="600"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
    <div class="product-card-badges">
      {sale && <span class="badge badge-sale">Sale</span>}
      {!available && <span class="badge badge-out">Sold out</span>}
      {lowStock && <span class="badge badge-low">Low stock</span>}
    </div>
  </div>
  <span class="product-card-name">{product.name}</span>
  <span class="product-card-meta">{product.category}{product.units.length > 1 ? ` · ${product.units.length} options` : ''}</span>
  <span class="price">
    {hasPriceRange(product) ? 'From ' : ''}
    <span class:list={[sale && 'price-sale']}>{formatPrice(minPrice(product))}</span>
    {compare && <span class="price-compare">{formatPrice(compare)}</span>}
  </span>
</a>
