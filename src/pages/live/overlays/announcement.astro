---
import Overlay from '../../../layouts/Overlay.astro';
---

<Overlay title="Announcement">
  <div class="ov announce pos-top" data-pos>
    <p class="announce-kicker" data-param="kicker" data-optional>Giveaway</p>
    <p class="announce-text" data-param="text">Comment your skin type to win the discovery set</p>
    <p class="announce-code" data-param="code" data-optional></p>
  </div>
</Overlay>
