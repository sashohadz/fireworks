---
import reportJson from '../../data/perf/latest.json';
import Lab from '../../layouts/Lab.astro';
import type { PerfReport } from '../../lib/perf';
import {
  addonDelta,
  extraWait,
  fmtCls,
  fmtKb,
  fmtMs,
  lcpStory,
  lowerFirst,
  pageDelta,
  perceivedLabels,
  ratingOf,
  result,
  signed,
  tapPause,
  thresholdFor,
  videoMax,
  weightContext,
  weightOf,
  type LcpStory,
  type PageDelta,
  type Perception,
} from '../../lib/perf-view';

const report = reportJson as unknown as PerfReport;
const core = report.scenarios.filter((s) => s.tier === 'core');
const addons = report.scenarios.filter((s) => s.tier === 'addon');
const stress = report.scenarios.find((s) => s.tier === 'stress');
const measuredOn = new Date(report.measuredAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

interface Card {
  id: string;
  label: string;
  shows: string;
  d: PageDelta;
  lcp: { before: string; after: string; rating: ReturnType<typeof ratingOf>; story: LcpStory };
  tap: { before: string; after: string; perception: Perception; tbtRating: ReturnType<typeof ratingOf>; tbt: string };
  cls: { before: string; after: string; rating: ReturnType<typeof ratingOf>; jumps: boolean };
  weight: { before: string; after: string; added: string; context: string; requests: number; video: number };
  lazy?: { bytes: string; sdkLoaded: boolean };
}

const cards: Card[] = core
  .map((s) => {
    const d = pageDelta(report, s.id);
    if (!d) return null;
    const lazy = result(report, s.id, 'lazy');
    const card: Card = {
      id: s.id,
      label: s.label,
      shows: s.shows.join(', '),
      d,
      lcp: {
        before: fmtMs(d.off.lighthouse.lcp),
        after: fmtMs(d.on.lighthouse.lcp),
        rating: ratingOf('lcp', d.on.lighthouse.lcp),
        story: lcpStory(d.off, d.on, lazy),
      },
      tap: {
        before: fmtMs(d.off.runtime.longestTaskMs),
        after: fmtMs(d.on.runtime.longestTaskMs),
        perception: tapPause(d.on.runtime.longestTaskMs),
        tbtRating: ratingOf('tbt', d.on.lighthouse.tbt),
        tbt: fmtMs(d.on.lighthouse.tbt),
      },
      cls: { before: fmtCls(d.off.lighthouse.cls), after: fmtCls(d.on.lighthouse.cls), rating: ratingOf('cls', d.on.lighthouse.cls), jumps: d.on.lighthouse.cls > 0.1 },
      // Weight before any video plays: whether autoplay starts streaming within a run varies, so video is shown on its own.
      weight: {
        before: fmtKb(weightOf(d.off)),
        after: fmtKb(weightOf(d.on)),
        added: fmtKb(Math.max(0, d.bytes)),
        context: weightContext(weightOf(d.on)),
        requests: d.requests,
        video: videoMax(d.on),
      },
      lazy: lazy ? { bytes: fmtKb(Math.max(0, weightOf(lazy) - weightOf(d.off))), sdkLoaded: lazy.runtime.sdkLoaded } : undefined,
    };
    return card;
  })
  .filter((c): c is Card => c !== null);

// The short version, from the typical setups.
const added = cards.map((c) => Math.max(0, c.d.bytes));
// The setup where the main content showed up latest, if any did.
const slowest = cards.filter((c) => c.lcp.story.kind === 'later').sort((a, b) => b.lcp.story.worst - a.lcp.story.worst)[0];
const offLcps = cards.map((c) => c.d.off.lighthouse.lcp);
const offLongest = Math.max(0, ...cards.map((c) => c.d.off.runtime.longestTaskMs));
const lcpSummary = slowest
  ? `On a slow connection, Firework's script competes with the page's main image: on the ${lowerFirst(slowest.label)} it showed up ${
      slowest.lcp.story.typical > 100
        ? `typically ${fmtMs(slowest.lcp.story.typical)} later, up to ${fmtMs(slowest.lcp.story.worst)} in the slowest run.`
        : `as fast in most runs, and ${fmtMs(slowest.lcp.story.worst)} later in the slowest.`
    }${slowest.lcp.story.lazyHelps ? " With Firework's lazy loader it showed up as fast as without Firework." : ''}`
  : "The main content shows up just as fast: Firework's script loads after your own content.";
const clsAllGood = cards.every((c) => !c.cls.jumps);
const longestPause = Math.max(0, ...cards.map((c) => c.d.on.runtime.longestTaskMs));
const pause = tapPause(longestPause);
const lazyKept = cards.filter((c) => c.lazy && !c.lazy.sdkLoaded);
const lazyExtra = lazyKept.map((c) => Math.max(0, result(report, c.id, 'lazy')!.network.bytes - c.d.off.network.bytes));
const stressDelta = stress ? pageDelta(report, stress.id) : undefined;
const stressLcp = stressDelta ? lcpStory(stressDelta.off, stressDelta.on) : undefined;
const addonRows = addons.map((a) => ({ a, delta: addonDelta(report, a)! })).filter((x) => x.delta);
const lcpOwn = report.results.filter((r) => r.mode === 'on').every((r) => r.runtime.lcpElement && !r.runtime.lcpElement.firework);
const lcpLine = thresholdFor('lcp');
const offMax = Math.max(0, ...offLcps);
const baselineText = `On this deliberately slow test phone, even the pages without Firework take ${fmtMs(Math.min(...offLcps))} to ${fmtMs(offMax)}, ${
  offMax > lcpLine.good * 1.15 ? `already over Google's ${fmtMs(lcpLine.good)} line` : offMax >= lcpLine.good * 0.85 ? `right at Google's ${fmtMs(lcpLine.good)} line` : `within Google's ${fmtMs(lcpLine.good)} line`
}.`;
const inpLine = thresholdFor('inp');
const clsLine = thresholdFor('cls');
const tbtLine = thresholdFor('tbt');

const dotFor = (level: Perception['level']) => ({ instant: 'ok', borderline: 'warn', noticeable: 'warn', clear: 'bad' })[level];
const dotForRating = (rating: string) => (rating === 'good' ? 'ok' : rating === 'poor' ? 'bad' : 'warn');
const capital = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const changeText = (ms: number) => (Math.abs(ms) <= 100 ? 'No noticeable change' : `${signed(fmtMs(Math.abs(ms)), ms >= 0)}: ${extraWait(Math.abs(ms)).text}`);
---

<Lab title="Page weight and vitals" description="What adding Firework does to a page, in plain words, measured on this store with Google's Lighthouse, with the full numbers for engineers on a second page.">
  <p class="eyebrow">Lab tool</p>
  <h1>Page weight and vitals</h1>
  <p class="lede">
    What adding Firework does to a page: how much heavier it gets, whether it shows up as fast, whether it still
    responds to taps, and whether anything jumps around. Measured on this store with Google's own tool, on a slow
    phone, so these are worst-case numbers. The short version first; the
    <a href="/lab/performance/details/">full numbers for engineers</a> are on their own page.
  </p>

  {cards.length === 0 && <p class="note">No measurements yet. Run <code>npm run perf:measure</code> and rebuild.</p>}

  {
    cards.length > 0 && (
      <section class="panel summary" aria-labelledby="summary-heading">
        <h2 id="summary-heading">The short version</h2>
        <ul class="summary-list">
          <li>
            <span class="dot dot-ok" aria-hidden="true" />
            <span>
              On a typical page, Firework adds between <strong>{fmtKb(Math.min(...added))}</strong> and <strong>{fmtKb(Math.max(...added))}</strong>
              before any video plays, mostly its own script. The heaviest of these pages ends up {weightContext(Math.max(...cards.map((c) => weightOf(c.d.on))))}.
              A playing video streams more on top, like any video on a page, and only while it plays.
            </span>
          </li>
          <li>
            <span class={`dot dot-${slowest ? (slowest.lcp.story.lazyHelps ? 'warn' : dotFor(slowest.lcp.story.perception.level)) : 'ok'}`} aria-hidden="true" />
            <span>
              {lcpSummary} {baselineText}
            </span>
          </li>
          <li>
            <span class={`dot dot-${clsAllGood ? 'ok' : 'bad'}`} aria-hidden="true" />
            <span>{clsAllGood ? 'Nothing jumps around: the space for the videos is reserved before they load.' : 'Something moves on at least one page while the videos load; see the cards below.'}</span>
          </li>
          <li>
            <span class={`dot dot-${dotFor(pause.level)}`} aria-hidden="true" />
            <span>
              While the page is still loading, a tap could wait up to <strong>{fmtMs(longestPause)}</strong> on a slow phone (without Firework: up to {fmtMs(offLongest)}), which {pause.text}. Once loaded, the page responds as before.
            </span>
          </li>
          {lazyKept.length > 0 && (
            <li>
              <span class="dot dot-ok" aria-hidden="true" />
              <span>
                With Firework's lazy loader, {lazyKept.length === cards.length ? 'each of these pages carries' : `${lazyKept.map((c) => `the ${lowerFirst(c.label)}`).join(' and ')} ${lazyKept.length > 1 ? 'each carry' : 'carries'}`} only about{' '}
                <strong>{fmtKb(Math.max(...lazyExtra))}</strong> extra until the shopper scrolls to the videos.
              </span>
            </li>
          )}
        </ul>
      </section>
    )
  }

  {
    cards.length > 0 && (
      <>
        <h2>Page by page</h2>
        <p class="small muted">Each card compares the page without Firework with the same page with it. Google's words (good, needs improvement, poor) are kept, with what they mean in practice.</p>
        <div class="cards">
          {cards.map((c) => (
            <article class="perf-card panel" aria-labelledby={`card-${c.id}`}>
              <h3 id={`card-${c.id}`}>{c.label}</h3>
              <p class="small muted">Shows: {c.shows}.</p>
              <dl class="qa">
                <div>
                  <dt>How much heavier?</dt>
                  <dd>
                    <span class="val">{c.weight.before} → {c.weight.after}</span>
                    <span class="why">
                      {c.weight.added} more before any video plays, {c.weight.requests} more requests. {capital(c.weight.context)}.
                      {c.weight.video > 50 * 1024 && ` A playing video streams more on top: up to ${fmtKb(c.weight.video)} in the first seconds of this test.`}
                    </span>
                  </dd>
                </div>
                <div>
                  <dt>Does the page show up as fast?</dt>
                  <dd>
                    <span class="val">{c.lcp.before} → {c.lcp.after}</span>
                    <span class={`chip chip-${dotForRating(c.lcp.rating.rating)}`}>{c.lcp.rating.label}</span>
                    <span class="why">
                      {c.lcp.story.text} Google's line for "good" is {fmtMs(lcpLine.good)}; without Firework this page took {c.lcp.before} on the same slow phone.
                    </span>
                  </dd>
                </div>
                <div>
                  <dt>Does it respond to taps?</dt>
                  <dd>
                    <span class="val">Longest pause while loading: {c.tap.before} → {c.tap.after}</span>
                    <span class={`chip chip-${dotFor(c.tap.perception.level)}`}>{perceivedLabels[c.tap.perception.level]}</span>
                    <span class="why">
                      A pause like that {c.tap.perception.text}. Lighthouse's blocking time: {c.tap.tbt} ({c.tap.tbtRating.label.toLowerCase()}; Lighthouse's line is {fmtMs(tbtLine.good)}).
                    </span>
                  </dd>
                </div>
                <div>
                  <dt>Does anything jump around?</dt>
                  <dd>
                    <span class="val">Layout shift {c.cls.before} → {c.cls.after}</span>
                    <span class={`chip chip-${dotForRating(c.cls.rating.rating)}`}>{c.cls.rating.label}</span>
                    <span class="why">{c.cls.jumps ? 'Yes: something moves while the videos load.' : 'No: the space for the videos is reserved before they load.'} Google's line is {clsLine.good}.</span>
                  </dd>
                </div>
                {c.lazy && (
                  <div>
                    <dt>With the lazy loader</dt>
                    <dd>
                      <span class="why">
                        {c.lazy.sdkLoaded
                          ? 'The videos are in the first screen, so the loader fetches Firework at once and changes little here.'
                          : `Only ${c.lazy.bytes} extra until the shopper scrolls to the videos. Nothing else loads before that.`}
                      </span>
                    </dd>
                  </div>
                )}
              </dl>
            </article>
          ))}
        </div>
      </>
    )
  }

  {
    addonRows.length > 0 && (
      <>
        <h2>What one more feature costs</h2>
        <p class="small muted">Each row is the extra on top of the setup it adds to, with Firework on in both. Weight is before any video plays.</p>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Adding</th><th>On top of</th><th>Weight</th><th>Longest pause</th><th>Main content</th></tr></thead>
            <tbody>
              {addonRows.map(({ a, delta }) => (
                <tr>
                  <td>{a.shows[a.shows.length - 1]}</td>
                  <td>{delta.base}</td>
                  <td>
                    {signed(fmtKb(Math.abs(delta.bytes)), delta.bytes >= 0)}, {signed(String(Math.abs(delta.requests)), delta.requests >= 0)} requests{delta.video > 50 * 1024 && <span class="small muted">, plus up to {fmtKb(delta.video)} of video while it plays</span>}
                  </td>
                  <td>{signed(fmtMs(Math.abs(delta.longest)), delta.longest >= 0)}</td>
                  <td>{delta.lcpWithinNoise ? 'Within the run-to-run spread' : changeText(delta.lcp)}</td>
                </tr>
              ))}
              {stress && stressDelta && (
                <tr>
                  <td>{stress.shows.join(' + ')}</td>
                  <td>the page without Firework</td>
                  <td>
                    {signed(fmtKb(Math.abs(stressDelta.bytes)), stressDelta.bytes >= 0)}, {signed(String(Math.abs(stressDelta.requests)), stressDelta.requests >= 0)} requests{videoMax(stressDelta.on) > 50 * 1024 && <span class="small muted">, plus up to {fmtKb(videoMax(stressDelta.on))} of video while it plays</span>}
                  </td>
                  <td>{signed(fmtMs(Math.abs(stressDelta.on.runtime.longestTaskMs - stressDelta.off.runtime.longestTaskMs)), stressDelta.on.runtime.longestTaskMs >= stressDelta.off.runtime.longestTaskMs)}</td>
                  <td>{stressLcp && stressLcp.kind !== 'later' ? 'No noticeable change' : changeText(stressDelta.lcp)}</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
        <p class="small muted">The last row is this demo store's showcase home page with four widgets at once, more than a shop would normally run on one page.</p>
      </>
    )
  }

  <h2>What these measurements mean</h2>
  <div class="meaning">
    <section>
      <h3>Does the page show up as fast?</h3>
      <p>
        Google calls this <strong>Largest Contentful Paint</strong>: when the biggest image or text block has painted.
        Google counts a page as good when it happens within {fmtMs(lcpLine.good)} for most visits, and poor beyond
        {' '}{fmtMs(lcpLine.poor)}. That line comes from research on how long people wait before losing focus, which
        puts the limit somewhere between 0.3 and 3 seconds. Firework's script loads after your own content, so it
        doesn't hold the page back; on a slow connection its requests can compete with your images for a moment.
      </p>
    </section>
    <section>
      <h3>Does it respond to taps?</h3>
      <p>
        Google measures this on real visits as <strong>Interaction to Next Paint</strong>: good within {inpLine.good} ms,
        poor beyond {inpLine.poor} ms. A lab test can't produce it, so this page shows the longest pause a tap could run
        into while the page is still loading. The research behind Google's line: delays up to about 100 ms feel like
        part of the tap, between 100 and 200 ms the link starts to break, over 200 ms the response no longer feels
        caused by the tap, and at 300 ms people rate a button press as poor. On a slow phone, Firework's script causes
        a few such pauses during loading; after that the page responds as before.
      </p>
    </section>
    <section>
      <h3>Does anything jump around?</h3>
      <p>
        <strong>Cumulative Layout Shift</strong> scores how much content moves while the page loads: good up to
        {' '}{clsLine.good}, poor above {clsLine.poor}. Firework's widgets don't cause this when their space is
        reserved, which is how this store embeds them.
      </p>
    </section>
    <section>
      <h3>How much heavier?</h3>
      <p>
        Weight isn't one of Google's vitals, but it is what the shopper's data plan pays for and what a slow connection
        spends time on. For scale, the 2025 Web Almanac puts the typical mobile home page at 2.56 MB. Firework's share is
        mostly its script and thumbnails. Video streams on top while it plays, like any video: a few hundred KB in the
        first seconds, only for shoppers who watch.
      </p>
    </section>
  </div>

  <h2>What we recommend</h2>
  <ol class="recs">
    <li>
      <strong>Use Firework's lazy loader on pages where the videos sit further down.</strong> Firework's own guidance:
      "In case your page relies on very fast first load, you can inject the async script (fwn-async.js ~1kB). It
      defers the main script injection until the widget components is visible in the viewport."
      {lazyKept.length > 0 && ` Measured here: ${lazyKept.map((c) => `the ${lowerFirst(c.label)} carries ${c.lazy!.bytes} extra until then${c.lcp.story.lazyHelps ? ', and its main image shows up as fast as without Firework' : ''}`).join('; ')}.`}
    </li>
    <li>
      <strong>One or two widgets per page.</strong> Every widget adds its own feed, thumbnails and previews.
      {stressDelta && cards[0] && ` The showcase home page with four widgets adds ${fmtKb(stressDelta.bytes)} before any video plays, against ${cards[0].weight.added} for a single carousel.`}
    </li>
    <li>
      <strong>Keep your own hero image as the biggest thing in the first screen.</strong> Then the "shows up as fast"
      measurement stays about your content.{lcpOwn ? " In every run here, the largest element was the store's own image, never a Firework one." : ''}
    </li>
    <li>
      <strong>Reserve the widget's space.</strong> Put each widget in a container with a minimum height that matches what
      it shows (a carousel row is 400px tall). That is why nothing jumps on these pages.
    </li>
    <li>
      <strong>Load after consent where a consent banner is required.</strong> Nothing loads for shoppers who decline,
      and the first paint is never affected. To be measured once the consent banner is in place.
    </li>
  </ol>
  <p>
    Expect real visits to do better than these numbers: Lighthouse simulates a slow phone on a slow 4G connection with
    an empty cache. A second page view within 30 minutes finds Firework's scripts already cached.
  </p>

  <h2>How it was measured</h2>
  <p>
    Measured {measuredOn} with Google Lighthouse {report.lighthouseVersion}, Firework SDK {report.sdkRelease}.
    {report.conditions.device}; {report.conditions.network.toLowerCase()}; CPU {report.conditions.cpu}.
    {' '}{report.conditions.cache}. Each number is the median of {report.results[0]?.runs ?? 0} runs. Every page was
    loaded three ways: without Firework, with the lazy loader, and with the full integration. The
    <a href="/lab/performance/details/">details page</a> has every number, a breakdown by sender, the biggest requests,
    and a way to run the same comparison in your own browser.
  </p>

  <h2>Sources</h2>
  <ul>
    <li><a href="https://web.dev/articles/vitals">Web Vitals</a> (Google): the three Core Web Vitals and their thresholds.</li>
    <li><a href="https://web.dev/articles/defining-core-web-vitals-thresholds">How the Core Web Vitals thresholds were defined</a> (Google): the perception research behind the 200 ms and 2.5 s lines, citing Michotte, Miller, Card and Kaaresoja et al.</li>
    <li><a href="https://web.dev/articles/rail">The RAIL model</a> (Google): what people perceive at 100 ms, 1 second and 10 seconds, building on <a href="https://www.nngroup.com/articles/response-times-3-important-limits/">Nielsen's three response-time limits</a>.</li>
    <li><a href="https://developer.chrome.com/docs/lighthouse/performance/lighthouse-total-blocking-time">Lighthouse: Total Blocking Time</a>: the lab stand-in for responsiveness.</li>
    <li><a href="https://almanac.httparchive.org/en/2025/page-weight">Web Almanac 2025: Page weight</a>: the typical page weights.</li>
    <li><a href="https://docs.firework.com/firework-for-developers/web/faq-and-troubleshooting">Firework FAQ</a>: the asynchronous loader.</li>
  </ul>
</Lab>

<style>
  .summary {
    margin: 16px 0 8px;
  }
  .summary h2 {
    margin-top: 0;
  }
  .summary-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 1.02rem;
  }
  .summary-list li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 10px;
    align-items: start;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    margin-top: 7px;
    display: inline-block;
  }
  .dot-ok {
    background: #0ca30c;
  }
  .dot-warn {
    background: #fab219;
  }
  .dot-bad {
    background: #d03b3b;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 14px;
    margin: 12px 0 6px;
  }
  .perf-card h3 {
    margin: 0 0 2px;
    font-size: 1.1rem;
  }
  .qa {
    margin: 10px 0 0;
    display: grid;
    gap: 10px;
  }
  .qa > div {
    border-top: 1px solid var(--line);
    padding-top: 8px;
  }
  .qa dt {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .qa dd {
    margin: 2px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    align-items: baseline;
  }
  .val {
    font-variant-numeric: tabular-nums;
  }
  .why {
    flex-basis: 100%;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .chip {
    font-size: 0.75rem;
    padding: 1px 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    white-space: nowrap;
  }
  .chip-ok {
    border-color: #0ca30c;
    color: #006300;
  }
  .chip-warn {
    border-color: #c98500;
    color: #8a5a00;
  }
  .chip-bad {
    border-color: #d03b3b;
    color: var(--danger);
  }
  .meaning {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 6px 24px;
  }
  .meaning h3 {
    font-size: 1.05rem;
    margin: 12px 0 4px;
  }
  .meaning p {
    margin: 0 0 8px;
    font-size: 0.95rem;
  }
  .recs li {
    margin-bottom: 8px;
  }
</style>
