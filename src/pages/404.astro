---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="section">
    <div class="container" style="max-width:640px">
      <h1>We couldn't find that page</h1>
      <p class="lede">It may have moved, or the link may be from an older version of the demo.</p>
      <p><a class="btn" href="/">Back to the store</a> <a class="btn btn-ghost" href="/lab">Open the lab</a></p>
    </div>
  </section>
</Base>
