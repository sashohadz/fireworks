---
import AvaWidget from '../../components/AvaWidget.astro';
import FwWidget from '../../components/FwWidget.astro';
import Base from '../../layouts/Base.astro';
import { products } from '../../lib/catalog';
import { storeFaqs } from '../../lib/help-content';



const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: storeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base title="Help and FAQ" description="Answers about shipping, returns, routines and ingredients." jsonLd={jsonLd}>
  <section class="section-tight">
    <div class="container help">
      <p class="eyebrow">Help</p>
      <h1>How can we help?</h1>
      <p class="lede">
        These pages double as training material for AVA, Firework's AI shopping assistant, alongside the FAQs on every
        product page.
      </p>
      <nav class="chip-row" aria-label="Help topics">
        <a class="chip" href="/help/shipping-returns">Shipping and returns</a>
        <a class="chip" href="/help/ingredients">Ingredient glossary</a>
        <a class="chip" href="#product-faqs">Product questions</a>
      </nav>

      <h2>Frequently asked questions</h2>
      <div class="accordion">
        {
          storeFaqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div>
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>

      <h2>Ask our AI product expert</h2>
      <p>Ask about routines, ingredients, shipping or returns. Answers come from our product pages and policies.</p>
      <div class="ava-button"><AvaWidget layout="button" /></div>
      <p class="small muted" data-demo-chrome>
        AVA's General Button. Its knowledge comes from the <a href="/lab/ava">AVA setup kit</a>.
      </p>

      <h2>How-to videos</h2>
      <FwWidget tag="fw-embed-feed" slot="howto" label="How-to videos" attrs={{ mode: 'row' }} />

      <h2 id="product-faqs">Product questions</h2>
      <ul class="product-faq-links">
        {
          products.map((p) => (
            <li>
              <a href={`/products/${p.handle}#faq-heading`}>{p.shortName}</a>
              <span class="muted small"> · {p.faqs.length} answers</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .help {
    max-width: 900px;
  }
  .help h2 {
    margin-top: 48px;
  }
  .ava-button {
    display: block;
    margin: 16px 0 8px;
  }
  .help nav {
    margin: 20px 0 8px;
  }
  .product-faq-links {
    columns: 2;
    padding-left: 1.1em;
  }
  @media (max-width: 640px) {
    .product-faq-links {
      columns: 1;
    }
  }
</style>
