---
import Base from '../../layouts/Base.astro';
import { glossary } from '../../lib/help-content';


---

<Base title="Ingredient glossary">
  <section class="section-tight">
    <div class="container prose">
      <p class="eyebrow">Help</p>
      <h1>Ingredient glossary</h1>
      <p class="lede">What goes into Fjordbloom formulas, and why.</p>
      <dl class="glossary">
        {
          glossary.map((g) => (
            <div>
              <dt>
                {g.name} <span class="muted small">({g.inci})</span>
              </dt>
              <dd>
                {g.what} <span class="small muted">Found in: {g.in}.</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>

<style>
  .glossary div {
    border-top: 1px solid var(--line);
    padding: 14px 0;
  }
  .glossary dt {
    font-weight: 600;
  }
  .glossary dd {
    margin: 4px 0 0;
    color: var(--ink-soft);
  }
</style>
