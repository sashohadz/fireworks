---
import Base from '../../layouts/Base.astro';
import { damagedNote, dispatchNote, returnRules, shippingRates, soldOutNote, support } from '../../lib/help-content';
---

<Base title="Shipping and returns">
  <section class="section-tight">
    <div class="container prose">
      <p class="eyebrow">Help</p>
      <h1>Shipping and returns</h1>
      <p class="note small">Fjordbloom is a demo brand. These policies are realistic examples for AVA training, not real terms.</p>

      <h2>Shipping</h2>
      <table>
        <thead><tr><th>Destination</th><th>Delivery time</th><th>Cost</th></tr></thead>
        <tbody>{shippingRates.map((r) => <tr><td>{r.destination}</td><td>{r.time}</td><td>{r.cost}</td></tr>)}</tbody>
      </table>
      <p>{dispatchNote}</p>

      <h2>Returns</h2>
      <ul>{returnRules.map((r) => <li>{r}</li>)}</ul>

      <h2>Damaged or missing items</h2>
      <p>{damagedNote}</p>

      <h2>Sold-out products</h2>
      <p>{soldOutNote()}</p>

      <h2>Contact</h2>
      <p>Email {support.email}, {support.hours}. We answer in {support.languages}.</p>
    </div>
  </section>
</Base>
